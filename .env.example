# Contact form — Microsoft 365 / Outlook SMTP
# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables.

# Mailbox the form sends FROM. Must be a real Microsoft 365 mailbox with
# SMTP AUTH enabled (Microsoft 365 admin center → Users → Active users →
# select the mailbox → Mail → Manage email apps → tick "Authenticated SMTP").
SMTP_USER=noreply@satisgroup.co.uk

# The mailbox password. If the mailbox has multi-factor authentication,
# create an app password instead (My Account → Security info → App passwords).
SMTP_PASS=

# Where submissions are delivered. Defaults to info@satisgroup.co.uk.
CONTACT_TO_EMAIL=info@satisgroup.co.uk

# Advanced overrides — the defaults suit Microsoft 365; leave unset normally.
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
